{
  "version": 1,
  "description": "Shared theme taxonomy so BMW G60 feedback and competitor findings can be compared. BMW feedback: theme = LEVEL3 override if present, else VFC level2 mapping; empty level2 -> unclassified. Replace non-breaking spaces in VFC names with plain spaces before lookup.",
  "themes": [
    {
      "id": "powertrain_performance",
      "label_de": "Antrieb & Leistung",
      "scope": "Engine/motor power, acceleration, transmission, start-stop, recuperation feel, drive readiness"
    },
    {
      "id": "range_charging_efficiency",
      "label_de": "Reichweite, Laden & Effizienz",
      "scope": "Electric range, charging speed/infrastructure/home charging, battery, fuel/energy consumption, refuelling"
    },
    {
      "id": "ride_handling",
      "label_de": "Fahrkomfort & Fahrdynamik",
      "scope": "Ride comfort, handling, steering, braking, suspension, tyres, driving modes"
    },
    {
      "id": "adas_parking",
      "label_de": "Fahrassistenz & Parken",
      "scope": "Cruise control, lane keeping, highway/hands-free assist, warnings, cameras, parking assist, remote parking"
    },
    {
      "id": "hmi_infotainment",
      "label_de": "Bedienung & Infotainment",
      "scope": "Touchscreen, operating concept, menus, displays, HUD, navigation, voice assistant, physical controls, in-car apps"
    },
    {
      "id": "connectivity_app_digital",
      "label_de": "Konnektivität, Smartphone & App",
      "scope": "CarPlay/Android Auto, phone pairing/charging, USB, eSIM/WiFi, companion app, remote services, OTA updates, digital upgrades"
    },
    {
      "id": "access_locking",
      "label_de": "Zugang, Türen & Kofferraumöffnung",
      "scope": "Locking/unlocking, keys, digital key, comfort access, door and tailgate operation, handles"
    },
    {
      "id": "seats_comfort",
      "label_de": "Sitze & Komfort",
      "scope": "Seat comfort, adjustment, heating/ventilation, massage, memory, general interior comfort"
    },
    {
      "id": "climate",
      "label_de": "Klima & Heizung",
      "scope": "Air conditioning, heating, blower, climate controls, heated steering wheel, sun protection"
    },
    {
      "id": "space_practicality",
      "label_de": "Platz & Praktikabilität",
      "scope": "Front/rear space, entry/exit, trunk and frunk, storage, cupholders, child seats, towing"
    },
    {
      "id": "interior_design_quality",
      "label_de": "Innenraum: Design & Materialqualität",
      "scope": "Interior styling, materials, trim, workmanship, ambient light, steering wheel feel, glass roof"
    },
    {
      "id": "exterior_design",
      "label_de": "Exterieur-Design",
      "scope": "Exterior styling, proportions, grille, bumpers, colours, wheels look"
    },
    {
      "id": "lighting_visibility",
      "label_de": "Licht & Sicht",
      "scope": "Headlights, exterior lighting, wipers, windshield, mirrors, all-round visibility"
    },
    {
      "id": "audio_acoustics",
      "label_de": "Audio & Akustik",
      "scope": "Sound system, cabin quietness, wind/road noise, engine sound, horn"
    },
    {
      "id": "safety",
      "label_de": "Sicherheit",
      "scope": "Perceived safety, crash safety, seat belts, emergency call"
    },
    {
      "id": "equipment_value",
      "label_de": "Ausstattung & Preis-Leistung (wahrgenommen)",
      "scope": "Standard vs optional equipment, missing features, perceived value for money (customer perception only, no price analysis)"
    },
    {
      "id": "overall_quality_ownership",
      "label_de": "Gesamtqualität & Ownership",
      "scope": "Overall impression, build quality and reliability in general, owner's manual, service, parts, 12V battery"
    },
    {
      "id": "unclassified",
      "label_de": "Nicht zuordenbar",
      "scope": "Generic praise/complaint without a clear topic"
    }
  ],
  "feedback_types": [
    "Likes",
    "Wants",
    "Difficult to Use",
    "Defect"
  ],
  "comparison_values": [
    "competitor_advantage",
    "bmw_advantage",
    "parity"
  ],
  "evidence_tiers": {
    "A": "Customer voice: owner review, owner forum post, owner survey",
    "B": "Professional test/review by automotive press",
    "C": "Manufacturer specification or configurator",
    "D": "Announcement, leak or forecast (forward-looking assumption)"
  },
