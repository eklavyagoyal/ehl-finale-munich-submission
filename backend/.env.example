# Copy to backend/.env (gitignored) and fill in.
OPENAI_API_KEY=

# mock = offline, deterministic fake outputs; openai = real calls
PARALLAX_LLM_MODE=mock
PARALLAX_DATABASE_URL=postgresql+psycopg://parallax@localhost:5433/parallax

# Model roles (confirm with: python -m parallax.cli models)
PARALLAX_MODEL_FAST=gpt-5-mini
PARALLAX_MODEL_STRONG=gpt-5
PARALLAX_JUDGE_MODELS=["gpt-5","gpt-5-mini","gpt-4.1"]
PARALLAX_EMBEDDING_MODEL=text-embedding-3-small

# tinytroupe | direct
PARALLAX_PERSONA_ENGINE=tinytroupe

# Where the research contract lives (schema.json, catalog/, decision-model.json)
PARALLAX_RESEARCH_ROOT=../research

PARALLAX_MAX_PARALLEL_CASES=5
PARALLAX_MAX_LLM_CALLS_PER_RUN=600

# Only for synthetic/demo data: lets pending sources reach the LLM. Keep false for real evidence.
PARALLAX_ALLOW_UNREVIEWED_EVIDENCE_FOR_LLM=false

# CLI against the deployed backend (smoke, push-research). Token = PARALLAX_API_API_TOKEN shown in nexus.
PARALLAX_REMOTE_URL=https://parallax.dehlwes.net
PARALLAX_REMOTE_TOKEN=
